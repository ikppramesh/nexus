<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="nexus_bg">#0B0D12</color>
    <color name="nexus_accent">#7C5CFF</color>

    <style name="Theme.Nexus" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nexus_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Nexus.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
